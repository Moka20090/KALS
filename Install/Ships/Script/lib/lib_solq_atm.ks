@LAZYGLOBAL OFF.
// ============================================================================
//  LIB_SOLQ_ATM.KS  --  THE SOL ATMOSPHERE FOR THE REFERENCE LOOKUPS
// ============================================================================
//  The guidance's reference functions (taemg.ks en_of, the density-altitude href) look the atmosphere up here; the
//  vehicle state itself uses ALTITUDEPRESSURE live. The curves are Earth's Kopernicus curves (26-key pressure /
//  temperature / temperatureSunMult, the latitude and axial bias curves), taken at the nominal latitude (the SLF,
//  28.6695) and day (0.5) with the axial bias at its annual mean.
//  The curve data is solq_atm_data.ks (generated by gen_taemg.py). sqa_curve is Unity's AnimationCurve.Evaluate: cubic
//  Hermite, flat outside the keys.
// ============================================================================

RUNONCEPATH(CHOOSE (CHOOSE "0:/ksm/lib/solq_atm_data.ksm" IF O6_KSM_GO ELSE "0:/lib/solq_atm_data.ks") IF (DEFINED O6_KSM_GO) ELSE "0:/lib/solq_atm_data.ks").

FUNCTION sqa_curve {                        // the curve's value at x: keys = LIST of LIST(t, v, in, out)
    PARAMETER keys, x.
    LOCAL n IS keys:LENGTH.
    IF x <= keys[0][0] { RETURN keys[0][1]. }
    IF x >= keys[n - 1][0] { RETURN keys[n - 1][1]. }
    LOCAL lo IS 0.
    LOCAL hi IS n - 1.
    UNTIL hi - lo <= 1 {
        LOCAL mid IS FLOOR((lo + hi) / 2).
        IF keys[mid][0] <= x { SET lo TO mid. } ELSE { SET hi TO mid. }
    }
    LOCAL t1 IS keys[lo][0].
    LOCAL v1 IS keys[lo][1].
    LOCAL m1 IS keys[lo][3].
    LOCAL t2 IS keys[hi][0].
    LOCAL v2 IS keys[hi][1].
    LOCAL m2 IS keys[hi][2].
    LOCAL dt IS t2 - t1.
    LOCAL t IS (x - t1) / dt.
    LOCAL tt IS t * t.
    LOCAL ttt IS tt * t.
    RETURN ((2 * ttt - 3 * tt + 1) * v1 + (ttt - 2 * tt + t) * dt * m1
            + (-2 * ttt + 3 * tt) * v2 + (ttt - tt) * dt * m2).
}

FUNCTION sqa_temperature_offset {           // the temperature offset, K, at the nominal latitude / day: the axial bias at its annual mean
    PARAMETER lat IS SQA_LAT_NOMINAL, day IS SQA_DAY_NOMINAL.
    LOCAL la IS ABS(lat).
    LOCAL ax IS SQA_AXBIAS_MEAN.
    RETURN sqa_curve(SQA_LATBIAS, la) + sqa_curve(SQA_LATSUN, la) * day + ax * sqa_curve(SQA_AXMULT, la).
}

GLOBAL SQA_TOFF_NOM IS sqa_temperature_offset().      // the nominal offset, K (constant: computed once)

FUNCTION sqa_pressure {                     // pressure at altitude h, Pa
    PARAMETER h.
    IF h >= SQA_ATM_TOP { RETURN 0.0. }
    RETURN sqa_curve(SQA_PRESS, h) * 1000.0.
}

FUNCTION sqa_temperature {                  // temperature at altitude h at the nominal latitude / day, K
    PARAMETER h.
    RETURN sqa_curve(SQA_TEMP, h) + sqa_curve(SQA_TSUN, h) * SQA_TOFF_NOM.
}

// One bracket for the three curves: SQA_PRESS, SQA_TEMP and SQA_TSUN share their key altitudes (checked at load:
// SQA_ONE_T), so sqa_density finds the bracket once (the last call's, while it still holds) and evaluates each curve
// on it with sqa_curve's own clamps and operations: the same density as three separate sqa_curve calls.
// taemg_en_of calls it 5-7 times per TAEM cycle.
FUNCTION sqaOneT {
    LOCAL n IS SQA_PRESS:LENGTH.
    IF n < 2 OR SQA_TEMP:LENGTH <> n OR SQA_TSUN:LENGTH <> n { RETURN FALSE. }
    FROM { LOCAL i IS 0. } UNTIL i >= n STEP { SET i TO i + 1. } DO {
        IF SQA_TEMP[i][0] <> SQA_PRESS[i][0] OR SQA_TSUN[i][0] <> SQA_PRESS[i][0] { RETURN FALSE. }
    }
    RETURN TRUE.
}
GLOBAL SQA_ONE_T IS sqaOneT().
GLOBAL sqaLo IS 0.                          // the last bracket's lower key

FUNCTION sqaBr {                            // x's bracket on the shared keys: -1 at / below the first, n - 1 at / above the last
    PARAMETER x.
    LOCAL n IS SQA_PRESS:LENGTH.
    IF x <= SQA_PRESS[0][0] { RETURN -1. }
    IF x >= SQA_PRESS[n - 1][0] { RETURN n - 1. }
    IF SQA_PRESS[sqaLo][0] <= x AND x < SQA_PRESS[sqaLo + 1][0] { RETURN sqaLo. }
    LOCAL lo IS 0.                          // sqa_curve's search
    LOCAL hi IS n - 1.
    UNTIL hi - lo <= 1 {
        LOCAL mid IS FLOOR((lo + hi) / 2).
        IF SQA_PRESS[mid][0] <= x { SET lo TO mid. } ELSE { SET hi TO mid. }
    }
    SET sqaLo TO lo.
    RETURN lo.
}

FUNCTION sqaAt {                            // sqa_curve(keys, x) on x's bracket b (sqaBr)
    PARAMETER keys, b, x.
    IF b < 0 { RETURN keys[0][1]. }
    IF b >= keys:LENGTH - 1 { RETURN keys[keys:LENGTH - 1][1]. }
    LOCAL t1 IS keys[b][0].
    LOCAL v1 IS keys[b][1].
    LOCAL m1 IS keys[b][3].
    LOCAL t2 IS keys[b + 1][0].
    LOCAL v2 IS keys[b + 1][1].
    LOCAL m2 IS keys[b + 1][2].
    LOCAL dt IS t2 - t1.
    LOCAL t IS (x - t1) / dt.
    LOCAL tt IS t * t.
    LOCAL ttt IS tt * t.
    RETURN ((2 * ttt - 3 * tt + 1) * v1 + (ttt - 2 * tt + t) * dt * m1
            + (-2 * ttt + 3 * tt) * v2 + (ttt - tt) * dt * m2).
}

FUNCTION sqa_density {                      // air density at altitude h, kg/m3
    PARAMETER h.
    IF NOT SQA_ONE_T {
        LOCAL t0 IS sqa_temperature(h).
        IF t0 <= 0.0 { RETURN 0.0. }
        RETURN sqa_pressure(h) * SQA_MOLAR / (SQA_R_GAS * t0).
    }
    LOCAL b IS sqaBr(h).
    LOCAL t IS sqaAt(SQA_TEMP, b, h) + sqaAt(SQA_TSUN, b, h) * SQA_TOFF_NOM.
    IF t <= 0.0 { RETURN 0.0. }
    LOCAL p IS 0.0.
    IF h < SQA_ATM_TOP { SET p TO sqaAt(SQA_PRESS, b, h) * 1000.0. }
    RETURN p * SQA_MOLAR / (SQA_R_GAS * t).
}
