// ---- generated: the globals the solve reads and writes (cs/DpCore.cs class DpG)
FUNCTION dpcs_g {
  RETURN LEXICON(
    "DP_FPA", DP_FPA,
    "DP_BACK_M", DP_BACK_M,
    "DP_COARSE_ON", DP_COARSE_ON,
    "DP_NGATE_LEG", DP_NGATE_LEG,
    "DP_NGATE_SIDE", DP_NGATE_SIDE,
    "DP_LAST", DP_LAST,
    "DP_TGT_SAVE", DP_TGT_SAVE,
    "EPR_T0", EPR_T0,
    "EPR_TGT_LAT", EPR_TGT_LAT,
    "EPR_TGT_LNG", EPR_TGT_LNG,
    "EPR_HINT_RHO", EPR_HINT_RHO,
    "EPR_PR_REF", EPR_PR_REF,
    "EPR_STEPS", EPR_STEPS,
    "EPR_IR", EPR_IR,
    "EPR_IV", EPR_IV,
    "EPR_PR", EPR_PR,
    "EPR_PV", EPR_PV,
    "EPR_IT", EPR_IT,
    "EPR_IARC", EPR_IARC,
    "EPR_IBK", EPR_IBK,
    "EPR_PT", EPR_PT,
    "EPR_PA", EPR_PA,
    "EPR_PVR", EPR_PVR,
    "EPR_PARC", EPR_PARC,
    "EPR_FAM_BANK_NOW", EPR_FAM_BANK_NOW,
    "EPR_IOK", EPR_IOK,
    "EPR_IDONE", EPR_IDONE,
    "EPR_HAVEPREV", EPR_HAVEPREV,
    "EPR_LAT_ON", EPR_LAT_ON,
    "EPR_LAT_TROT", EPR_LAT_TROT,
    "EPR_LAT_CMD", EPR_LAT_CMD,
    "EPR_LAT_RATE", EPR_LAT_RATE,
    "EPR_LAT_SIGN", EPR_LAT_SIGN,
    "EPR_LAT_REV", EPR_LAT_REV,
    "EPR_TERM_ALT", EPR_TERM_ALT,
    "EPR_TERM_VEL", EPR_TERM_VEL,
    "EPR_TERM_WHY", EPR_TERM_WHY,
    "EPR_MP_LAT", EPR_MP_LAT,
    "EPR_MP_LNG", EPR_MP_LNG,
    "EPR_MP_TROT", EPR_MP_TROT,
    "EPR_MP_GC", EPR_MP_GC,
    "EPR_SOL_LAT", EPR_SOL_LAT,
    "EPR_SOL_LNG", EPR_SOL_LNG).
}

FUNCTION dpcs_apply_g {
  PARAMETER g.
  SET DP_FPA TO g["DP_FPA"].
  SET DP_BACK_M TO g["DP_BACK_M"].
  SET DP_COARSE_ON TO g["DP_COARSE_ON"].
  SET DP_NGATE_LEG TO g["DP_NGATE_LEG"].
  SET DP_NGATE_SIDE TO g["DP_NGATE_SIDE"].
  SET DP_LAST TO g["DP_LAST"].
  SET DP_TGT_SAVE TO g["DP_TGT_SAVE"].
  SET EPR_T0 TO g["EPR_T0"].
  SET EPR_TGT_LAT TO g["EPR_TGT_LAT"].
  SET EPR_TGT_LNG TO g["EPR_TGT_LNG"].
  SET EPR_HINT_RHO TO g["EPR_HINT_RHO"].
  SET EPR_PR_REF TO g["EPR_PR_REF"].
  SET EPR_STEPS TO g["EPR_STEPS"].
  SET EPR_IR TO g["EPR_IR"].
  SET EPR_IV TO g["EPR_IV"].
  SET EPR_PR TO g["EPR_PR"].
  SET EPR_PV TO g["EPR_PV"].
  SET EPR_IT TO g["EPR_IT"].
  SET EPR_IARC TO g["EPR_IARC"].
  SET EPR_IBK TO g["EPR_IBK"].
  SET EPR_PT TO g["EPR_PT"].
  SET EPR_PA TO g["EPR_PA"].
  SET EPR_PVR TO g["EPR_PVR"].
  SET EPR_PARC TO g["EPR_PARC"].
  SET EPR_FAM_BANK_NOW TO g["EPR_FAM_BANK_NOW"].
  SET EPR_IOK TO g["EPR_IOK"].
  SET EPR_IDONE TO g["EPR_IDONE"].
  SET EPR_HAVEPREV TO g["EPR_HAVEPREV"].
  SET EPR_LAT_ON TO g["EPR_LAT_ON"].
  SET EPR_LAT_TROT TO g["EPR_LAT_TROT"].
  SET EPR_LAT_CMD TO g["EPR_LAT_CMD"].
  SET EPR_LAT_RATE TO g["EPR_LAT_RATE"].
  SET EPR_LAT_SIGN TO g["EPR_LAT_SIGN"].
  SET EPR_LAT_REV TO g["EPR_LAT_REV"].
  SET EPR_TERM_ALT TO g["EPR_TERM_ALT"].
  SET EPR_TERM_VEL TO g["EPR_TERM_VEL"].
  SET EPR_TERM_WHY TO g["EPR_TERM_WHY"].
  SET EPR_MP_LAT TO g["EPR_MP_LAT"].
  SET EPR_MP_LNG TO g["EPR_MP_LNG"].
  SET EPR_MP_TROT TO g["EPR_MP_TROT"].
  SET EPR_MP_GC TO g["EPR_MP_GC"].
  SET EPR_SOL_LAT TO g["EPR_SOL_LAT"].
  SET EPR_SOL_LNG TO g["EPR_SOL_LNG"].
}
