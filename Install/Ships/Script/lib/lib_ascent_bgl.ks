// lib_ascent_bgl.ks -- THE LIVE BLUE / GREEN: the GREEN boundary is the reach of an approximate footprint, where entry
// and TAEM guidance can catch the orbiter and bring it to a landing; no false BLUE, the GREEN as tight as that allows (the project owner).
// THE FOOTPRINT (the offline maps, checked against the real sites, generate the data below): from the 2EO contingency
// MECO (where the entry starts) the runway positions -- d km from the MECO ground point to the runway's middle, rel deg
// from the MECO ground heading (+ right) -- from which the GREEN pullout (OPS 6's CONT 1: the ECAL bank toward the site,
// the GRTLS), TAEM and A/L catch the orbiter (TAEM to the A/L interface on the final, the touchdown 0 .. 3000 m past
// the threshold); per MECO VI, two branches: in plane (shallow MECOs) and yawed (steep, low); the union of the runway
// across and along the approach, holes filled, the span widened by ASC_BGL_PUSH km and rounded toward GREEN between
// bearings and templates. THE MECO from a 2nd failure at a path point by the table of the offline sim's contingency
// flights over TWO inputs: the VI at the 2nd failure and dh, its altitude less the both-out failures' at that VI (bgl_x;
// after a 1EO the path is the TAL / ATO / press on two SSMEs, 5-27 km higher than both-out at the same VI, so its
// contingency burns longer); the offline grid, both bases (36.25 and 51.6), both-out and the first SSME out flown as
// the TAL or the press; every flight heads up from the 2nd failure (in a 2EO of any kind the stack rolls to heads up at
// once: ops1q's asc_fail). THE SWEEP over the ARD's path (the 2nd failure at each point): per point and yaw (none; left
// / right 45 deg, and left / right 20 deg, in MODE SEL 1) the best ELS's margin (km inside the widened span) -> the
// windows in vi2 (an edge where the margin crosses 0 between two points, else halfway) -> ASC_ABR_CONT's 2EO list (the
// pages' BLUE / GREEN, the contingency's site) + ASC_BGL_YAW (each window's yaw) + ASC_BGL_EARLY (GREEN by the early
// MECO: the early C/O cuts early only when the early MECO scores better; MODE SEL 2 scores each site at the better of
// its two MECOs). MODE SEL 0 points: none where the pages' 2EO line opens a mode (from ASC_BGL_V2: PEG flies it), below
// it scored as mode 1 (ops1q's asc_cnt_pick flies mode 1 there); each window's mode (ASC_BGL_MD) is the one ops1q flies
// in it. Vessel-free (no LATLNG, no BODY, no CONSTANT): ops1q hands it the path. 3EO: its own templates, two sets by the
// cutoff's flight-path angle: ASC_BGL_FP3 the nominal (steep) cutoffs (branch ASC_BGL_BR3), ASC_BGL_FP3F the
// flat ones of a post-1EO path (branch ASC_BGL_BR3F), and bgl_point3 (the margin interpolated between them by the angle).
@LAZYGLOBAL OFF.
RUNONCEPATH("0:/lib/lib_ascent_abr.ks").   // ASC_ABR_CONT (the windows go into its 2EO list)
RUNONCEPATH("0:/lib/lib_ascent_cnt.ks").   // asc_cnt_sel (MODE SEL at a path point)
RUNONCEPATH("0:/lib/lib_ascent_ard.ks").   // ASC_ARD_W (the planet's rotation, rad/s; ops1q sets it)

// ---- GENERATED DATA BEGIN (offline: the 2EO footprint maps (caught, the longest run per bearing) with the 20 deg yaw branch, and the MECO table)
// the East Coast ELS: LIST(key, lat, lng) deg, the midpoint of its two thresholds (hud/hud_runways.txt)
GLOBAL ASC_BGL_SITES IS LIST(LIST("BDA", 32.363417, -64.6739175), LIST("MYR", 33.6781312, -78.9281342), LIST("NKT", 34.896111, -76.8738527), LIST("DOV", 39.1302698, -75.4704165), LIST("LGA", 40.7795631, -73.875039), LIST("YHZ", 44.9020845, -63.4914568), LIST("YQX", 48.9402333, -54.5606918)).
// the footprint's bearings (deg from the MECO ground heading, + right)
GLOBAL ASC_BGL_REL IS LIST(-80, -70, -60, -50, -40, -30, -20, -10, 0, 10, 20, 30, 40, 50, 60).
// per branch (0: yaw 0, 1: yawed 45 deg, 2: yawed 20 deg) its templates by MECO VI: LIST(VI m/s, d_min per bearing, d_max per bearing) km,
