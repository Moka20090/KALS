      "TAL_2EO", LIST(-147.909541, 1574.382746, -99.958475, 1548.827589, -75.493712, 1541.864768, -63.125818, 1532.678257, -50.679239, 1523.540273, -38.150283, 1525.731109, -25.525998, 1516.61325, -12.809255, 1507.544314, 0, 1509.682622, 25.883824, 1491.634259, 52.15668, 1484.740209, 105.885071, 1460.07943, 161.297915, 1446.369277),
