      "ATO_2EO", LIST(-148.108652, 2641.191896, -100.184486, 2218.003995, -75.663109, 2120.839455, -63.27751, 2074.078629, -50.801198, 2044.849975, -38.23291, 2016.06372, -25.578709, 1987.711032, -12.836472, 1959.785508, 0, 1932.280329, 25.955693, 1893.481761, 52.28685, 1855.466113, 106.140589, 1781.720115, 161.669577, 1738.015617),
      "PRESS_2EO", LIST(-147.441508, 100000, -99.614784, 100000, -75.217388, 100000, -62.898244, 100000, -50.503192, 100000, -38.097825, 3279.461502, -25.53019, 3005.030972, -12.817172, 2881.149297, 0, 2369.793094, 25.962806, 2208.272537, 52.305581, 2110.520936, 106.193292, 1976.595175, 161.747911, 1881.800226)))).
// the contingency's ELS per SSMEs out (2, 3): (VI lo, VI hi m/s, the site key) triples; outside them: "NONE"
// (BLUE). 2EO: Bermuda after both out at 142-162.5 s on the nominal; 3EO: none flown yet.
GLOBAL ASC_ABR_CONT IS LIST(LIST(1218.021056, 1412.101836, "BDA"), LIST()).

FUNCTION asc_abr_new { RETURN LEXICON("t", -1, "d", 0, "dm", 0, "m1", FALSE, "n3", FALSE, "frz", FALSE,
  "b", LEXICON(), "k", 0, "set", FALSE). }

FUNCTION asc_abr_lin {                    // y at x on (x, y) pairs (x rising), clamped to the ends
  PARAMETER pr, x.
  IF x <= pr[0] { RETURN pr[1]. }
  FROM { LOCAL i IS 2. } UNTIL i >= pr:LENGTH STEP { SET i TO i + 2. } DO {
    IF x <= pr[i] { RETURN pr[i - 1] + (x - pr[i - 2]) / (pr[i] - pr[i - 2]) * (pr[i + 1] - pr[i - 1]). }
  }
  RETURN pr[pr:LENGTH - 1].
}

// once a second: the variant's set (once asc_ssme_detect has run), delta, the boundaries' VIs (m/s) in
// asc["abr"]["b"]; delta 0 before liftoff (the nominal marks)
FUNCTION asc_abr_tick {
  PARAMETER asc.
  LOCAL a IS asc["abr"].
  LOCAL now IS TIME:SECONDS.
  IF now < a["t"] + 1 { RETURN. }
  SET a["t"] TO now.
  IF NOT a["set"] AND asc["ssme_ok"] {
    LOCAL kb IS 0.
    FROM { LOCAL i IS 1. } UNTIL i >= ASC_ABR_SETS:LENGTH STEP { SET i TO i + 1. } DO {
      IF ABS(ASC_ABR_SETS[i][0] - ASC_KMAX_ABORT) < ABS(ASC_ABR_SETS[kb][0] - ASC_KMAX_ABORT) { SET kb TO i. }
    }
    SET a["k"] TO kb.
    SET a["set"] TO TRUE.
  }
  LOCAL s IS ASC_ABR_SETS[a["k"]].
  LOCAL n IS asc["ssme"]:LENGTH.
  IF n >= 3 { SET a["n3"] TO TRUE. }
  IF a["n3"] AND n < 3 { SET a["frz"] TO TRUE. }
  IF a["frz"] { RETURN. }
  IF n > 0 AND asc["t_lo"] >= 0 {
    LOCAL vex IS asc["ssme"][0]:VISP * CONSTANT:G0.
    LOCAL res IS ASC_ET_RESERVE_FRAC * asc["et_full"].
    LOCAL et IS asc_burnable(asc["ssme"]).
    LOCAL met IS now - asc["t_lo"].
    LOCAL ph IS asc["phase"].
    IF ph = "PAD" OR ph = "STAGE1" OR ph = "SRBSEP" {
      IF NOT a["m1"] AND met >= 1 {
        SET a["dm"] TO SHIP:MASS - (ASC_ABR_M1 - ASC_ABR_MD * (met - 1)).
        IF asc:HASKEY("srb_dd") { SET a["dm"] TO a["dm"] - asc["srb_dd"]. }   // the SRBs' part: not the core's
        SET a["m1"] TO TRUE.
      }
      LOCAL mc IS ASC_ABR_MC.
      IF et > res AND mc + a["dm"] + res > 0 {
        SET a["d"] TO vex * (LN((mc + a["dm"] + et) / (mc + a["dm"] + res)) - LN((mc + et) / (mc + res))).
      }
    } ELSE {
      LOCAL m IS SHIP:MASS.
      LOCAL prop IS et - res.
      IF prop > 0 AND prop < m {
        SET a["d"] TO vex * LN(m / (m - prop)) - asc_abr_lin(s[2], SHIP:VELOCITY:ORBIT:MAG)
          - (ASC_VDMAG - ASC_ABR_VD).
      }
    }
  }
  FOR k IN s[3]:KEYS { SET a["b"][k] TO asc_abr_lin(s[3][k], a["d"]). }
  // no 2EO mode before the VI from which a 2EO holds the droop's floor (lib_ascent_cnt asc_drp_pass's vi_b,
  // m/s; on a light craft this table's 2EO TAL is at 4205 ft/s, the floor held from ~4430)
  IF asc:HASKEY("drp") { IF asc["drp"]["vi_b"] > 0 {
    FOR k IN LIST("TAL_2EO", "ATO_2EO", "PRESS_2EO") { SET a["b"][k] TO MAX(a["b"][k], asc["drp"]["vi_b"]). }
  } }
}

FUNCTION asc_abr_site {                   // the contingency's ELS with nout SSMEs out at vi (m/s): its key, else
  PARAMETER nout, vi.                     // "NONE" (BLUE)
  LOCAL w IS ASC_ABR_CONT[MIN(MAX(nout, 2), 3) - 2].
  FROM { LOCAL i IS 0. } UNTIL i + 2 >= w:LENGTH STEP { SET i TO i + 3. } DO {
    IF vi >= w[i] AND vi < w[i + 1] { RETURN w[i + 2]. }
  }
  RETURN "NONE".
}
