      "PRESS_2EO", LIST(-145.715803, 100000, -98.474451, 100000, -74.375368, 100000, -62.372157, 3486.554935, -50.254787, 3066.745961, -37.86069, 2908.995737, -25.3472, 2786.701507, -12.742104, 2264.264119, -0, 2174.551404, 25.781873, 2075.433053, 51.944264, 1997.916182, 105.481954, 1883.026493, 160.694102, 1789.747397))),
  // the FOCF (STS-1): 100 %, 100 % (the dV table linear within 5.13 m/s in stage 2, from 125 s)
  LIST(100, 100, LIST(879.492869, 3612.140926, 1004.492869, 3285.76446, 1129.492869, 3069.43828, 1254.492869, 2883.023454, 1379.492869, 2713.060662, 1504.492869, 2553.749366, 1629.492869, 2401.903284, 1754.492869, 2255.577465, 1879.492869, 2113.427728, 2004.492869, 1974.527818, 2129.492869, 1838.184211, 2254.492869, 1703.865223, 2379.492869, 1571.160458, 2504.492869, 1439.750455, 2629.492869, 1309.375864, 2754.492869, 1179.818329, 2879.492869, 1050.910177, 3004.492869, 922.510015, 3129.492869, 794.497702, 3254.492869, 666.720552, 3379.492869, 539.018287, 3504.492869, 411.375236, 3629.492869, 283.728705, 3754.492869, 155.863872, 3844.700323, 63.513412),
    LEXICON(
      "E_TAL", LIST(-207.099815, 100000, -149.318997, 100000, -117.13643, 892.459908, -97.585359, 888.630389, -77.003907, 885.156972, -55.444117, 882.056412, -32.666484, 879.211207, -12.051786, 878.176191, 0, 879.312, 24.420129, 876.069295, 49.441146, 848.074823, 101.395586, 702.40148, 155.88626, 556.288384),
